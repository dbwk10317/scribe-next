# scribe-next: systemd unit for scribed (Ubuntu 24.04, Rocky Linux 9; checked with systemd-analyze verify only).
# User:    sudo useradd --system --no-create-home --shell /usr/sbin/nologin scribe
# Install: sudo install -D -m 644 examples/scribed.service /etc/systemd/system/scribed.service
#          sudo systemctl daemon-reload && sudo systemctl enable --now scribed
# Config:  /etc/scribe/scribe.conf (examples/docker.conf is a working default). It must be readable
#          by the scribe user; UMask=0027 keeps the files scribed creates out of reach of other users.
# Files:   /var/log/scribed (file stores) and /var/lib/scribed (for buffer store spools if you configure
#          one; the default config has none) are created for the scribe user. Writing anywhere else
#          needs a drop-in with ReadWritePaths=. Only IPv4/IPv6/Unix sockets are allowed, so network
#          stores reach other scribed servers over TCP as usual.
[Unit]
Description=Scribe log aggregation server (scribe-next)
After=network.target

[Service]
Type=simple
User=scribe
Group=scribe
LogsDirectory=scribed
StateDirectory=scribed
ExecStart=/usr/local/bin/scribed -c /etc/scribe/scribe.conf
# On SIGTERM (systemctl stop) scribed drains its queues and closes its stores, the same as the fb303
# shutdown RPC, and exits 0. systemd sends SIGKILL if it is still running after TimeoutStopSec.
TimeoutStopSec=90
# Listener failures (port in use, invalid wire limits) exit with code 1 and are retried every
# RestartSec; check journalctl -u scribed. A bad store configuration keeps scribed running with
# status WARNING, so it is not restarted.
Restart=on-failure
RestartSec=5
# scribed raises its open-file limit to 65535 at startup; this hard limit lets that succeed.
LimitNOFILE=65536
UMask=0027
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
